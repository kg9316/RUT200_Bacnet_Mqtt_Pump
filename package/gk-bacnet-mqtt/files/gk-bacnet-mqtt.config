config gateway 'main'
        option enabled '1'
        option mqtt_enabled '0'
        option bacnet_interface 'br-lan'
        option mqtt_host '127.0.0.1'
        option mqtt_port '1883'
        option mqtt_mode 'gk_cloud'
        option mqtt_tls '0'
        option mqtt_ca_file '/etc/ssl/certs/ca-certificates.crt'
        option mqtt_cert_file ''
        option mqtt_key_file ''
        option controller_id ''
        option controller_license ''
        option topic_root 'bacnet'
        option poll_ms '60000'
        option rpm_batch_max '30'
        option discovery_ms '600000'
        option max_age_sec '300'
        option min_send_sec '0'
        option cov_threshold '0'
        option mobile_max_age_sec '0'
        option mobile_min_send_sec '300'
        option mobile_cov_threshold '0.1'

#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

# RutOS Package Manager installs third-party package payloads below /usr/local.
# Direct opkg installs use the standard /usr/sbin path.
if [ -x /usr/local/usr/sbin/gk-bacnet-mqtt ]; then
        PROG=/usr/local/usr/sbin/gk-bacnet-mqtt
else
        PROG=/usr/sbin/gk-bacnet-mqtt
fi

start_service()
{
        local enabled bacnet_interface mqtt_host mqtt_port topic_root poll_ms discovery_ms max_age_sec
        config_load gk_bacnet_mqtt
        # Keep the control process alive while disabled: it serves status/imports
        # and watches Enabled. The daemon closes BACnet and MQTT itself.
        mkdir -p /tmp/gk-bacnet-mqtt-import
        chown root:uhttpd /tmp/gk-bacnet-mqtt-import
        chmod 0770 /tmp/gk-bacnet-mqtt-import
        config_get bacnet_interface main bacnet_interface "br-lan"
        config_get mqtt_host main mqtt_host "127.0.0.1"
        config_get mqtt_port main mqtt_port "1883"
        config_get topic_root main topic_root "bacnet"
        config_get poll_ms main poll_ms "5000"
        config_get discovery_ms main discovery_ms "10000"
        config_get max_age_sec main max_age_sec "300"
        procd_open_instance
        procd_set_param command "$PROG" "$bacnet_interface" "$mqtt_host" "$mqtt_port" "$topic_root" "$poll_ms" "$discovery_ms" "$max_age_sec"
        procd_set_param respawn 5 10 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
}

service_triggers()
{
        procd_add_reload_trigger "gk_bacnet_mqtt"
}

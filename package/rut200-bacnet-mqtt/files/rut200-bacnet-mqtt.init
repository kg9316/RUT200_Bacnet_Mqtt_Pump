#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/rut200-bacnet-mqtt

start_service()
{
        local enabled bacnet_interface mqtt_host mqtt_port topic_root
        config_load rut200-bacnet-mqtt
        config_get_bool enabled main enabled 0
        [ "$enabled" -eq 1 ] || return 0
        config_get bacnet_interface main bacnet_interface "br-lan"
        config_get mqtt_host main mqtt_host "127.0.0.1"
        config_get mqtt_port main mqtt_port "1883"
        config_get topic_root main topic_root "bacnet"
        procd_open_instance
        procd_set_param command "$PROG" "$bacnet_interface" "$mqtt_host" "$mqtt_port" "$topic_root"
        procd_set_param respawn 5 10 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
}

service_triggers()
{
        procd_add_reload_trigger "rut200-bacnet-mqtt"
}
